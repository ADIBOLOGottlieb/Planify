APP_NAME=Planify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.planify.tg
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL 8 (InnoDB, utf8mb4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planify
DB_USERNAME=planify
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Emails (vérification d'adresse, codes de réinitialisation).
# En développement : MAIL_MAILER=log (les emails sont écrits dans storage/logs).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@planify.tg"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (notifications push) — compte de service JSON
FCM_PROJECT_ID=
FCM_CREDENTIALS=/var/www/planify-api/storage/app/firebase-service-account.json

# Sous-domaine de l'interface d'administration (laisser vide en local)
ADMIN_DOMAIN=
